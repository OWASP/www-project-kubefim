# Linux build environment for regenerating the embedded eBPF objects.
FROM golang:1.26.7-bookworm@sha256:6ef6e30f0ea5c384f6d111cf856e024e3086bbdcb1779da3f3b3fbba0aea53d2

# Install clang, llvm, libbpf, git, and other C build tools
RUN apt-get update && apt-get install -y \
    clang \
    llvm \
    libbpf-dev \
    build-essential \
    linux-headers-generic \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory inside the container
WORKDIR /app
